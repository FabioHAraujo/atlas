{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Atlas",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "decorations": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "DeveloperTool",
    "linux": {
      "deb": {
        "section": "devel",
        "depends": ["git"],
        "files": {
          "/usr/bin/atlas": "../../target/release/atlas"
        }
      },
      "rpm": {
        "depends": ["git"],
        "files": {
          "/usr/bin/atlas": "../../target/release/atlas"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
