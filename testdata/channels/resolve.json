{
 "_doc": "Shared by atlas-core (Rust) and site/functions (TS): channel resolution of tags that releases.atom lists plus the releases/latest redirect tag. Producer-shaped data: tags are what the Atom <link href> carries after percent-decoding.",
 "cases": [
  {
   "name": "beta channel takes the beta, never the newer alpha line",
   "tags": [
    "v1.5.0-alpha.1",
    "v1.4.0-beta.2",
    "v1.4.0-beta.1",
    "v1.3.0"
   ],
   "stable_tag": "v1.3.0",
   "expect": {
    "stable": "v1.3.0",
    "beta": "v1.4.0-beta.2",
    "alpha": "v1.5.0-alpha.1"
   },
   "note": ""
  },
  {
   "name": "stable release outranks its own betas and rcs",
   "tags": [
    "v1.4.0",
    "v1.4.0-rc.1",
    "v1.4.0-beta.3",
    "v1.3.0"
   ],
   "stable_tag": "v1.4.0",
   "expect": {
    "stable": "v1.4.0",
    "beta": "v1.4.0",
    "alpha": "v1.4.0"
   },
   "note": "alpha/beta users are never left on a worse build than stable"
  },
  {
   "name": "alpha.10 beats alpha.9 (numeric identifiers)",
   "tags": [
    "v1.4.0-alpha.9",
    "v1.4.0-alpha.10",
    "v1.4.0-alpha.2",
    "v1.3.0"
   ],
   "stable_tag": "v1.3.0",
   "expect": {
    "stable": "v1.3.0",
    "beta": "v1.3.0",
    "alpha": "v1.4.0-alpha.10"
   },
   "note": ""
  },
  {
   "name": "rc is offered on beta and alpha, ordered after beta",
   "tags": [
    "v1.4.0-rc.1",
    "v1.4.0-beta.9",
    "v1.3.0"
   ],
   "stable_tag": "v1.3.0",
   "expect": {
    "stable": "v1.3.0",
    "beta": "v1.4.0-rc.1",
    "alpha": "v1.4.0-rc.1"
   },
   "note": ""
  },
  {
   "name": "unknown prerelease labels are offered nowhere",
   "tags": [
    "v1.9.0-nightly.20261012",
    "v1.4.0-foo.1",
    "v1.3.0"
   ],
   "stable_tag": "v1.3.0",
   "expect": {
    "stable": "v1.3.0",
    "beta": "v1.3.0",
    "alpha": "v1.3.0"
   },
   "note": ""
  },
  {
   "name": "non-semver moving tags (nightly, collab-staging) are ignored",
   "tags": [
    "nightly",
    "collab-staging",
    "v1.4.0-beta.1",
    "v1.3.0"
   ],
   "stable_tag": "v1.3.0",
   "expect": {
    "stable": "v1.3.0",
    "beta": "v1.4.0-beta.1",
    "alpha": "v1.4.0-beta.1"
   },
   "note": ""
  },
  {
   "name": "percent-encoded and v-less tags still parse; build metadata is ignored",
   "tags": [
    "v1.4.0-beta.1+sha.abc",
    "1.4.0-beta.2",
    "v1.3.0"
   ],
   "stable_tag": "v1.3.0",
   "expect": {
    "stable": "v1.3.0",
    "beta": "1.4.0-beta.2",
    "alpha": "1.4.0-beta.2"
   },
   "note": ""
  },
  {
   "name": "empty feed falls back to the stable redirect",
   "tags": [],
   "stable_tag": "v1.3.0",
   "expect": {
    "stable": "v1.3.0",
    "beta": "v1.3.0",
    "alpha": "v1.3.0"
   },
   "note": ""
  },
  {
   "name": "no release at all resolves to nothing",
   "tags": [],
   "stable_tag": null,
   "expect": {
    "stable": null,
    "beta": null,
    "alpha": null
   },
   "note": ""
  },
  {
   "name": "feed older than the stable redirect: the redirect wins",
   "tags": [
    "v1.2.0-beta.1",
    "v1.2.0-alpha.1"
   ],
   "stable_tag": "v1.3.0",
   "expect": {
    "stable": "v1.3.0",
    "beta": "v1.3.0",
    "alpha": "v1.3.0"
   },
   "note": ""
  },
  {
   "name": "a stable hotfix published after a prerelease does not hide it",
   "tags": [
    "v1.3.1",
    "v1.4.0-beta.1",
    "v1.3.0"
   ],
   "stable_tag": "v1.3.1",
   "expect": {
    "stable": "v1.3.1",
    "beta": "v1.4.0-beta.1",
    "alpha": "v1.4.0-beta.1"
   },
   "note": ""
  },
  {
   "name": "leading-zero numeric identifiers are invalid semver and ignored",
   "tags": [
    "v1.4.0-alpha.01",
    "v1.4.0-alpha.1",
    "v1.3.0"
   ],
   "stable_tag": "v1.3.0",
   "expect": {
    "stable": "v1.3.0",
    "beta": "v1.3.0",
    "alpha": "v1.4.0-alpha.1"
   },
   "note": ""
  },
  {
   "name": "default-channel alpha is /releases/latest: stable and beta never follow it",
   "tags": [
    "v1.5.0-alpha.4",
    "v1.5.0-alpha.3",
    "v1.4.0",
    "v1.4.0-beta.1"
   ],
   "stable_tag": "v1.5.0-alpha.4",
   "expect": {
    "stable": "v1.4.0",
    "beta": "v1.4.0",
    "alpha": "v1.5.0-alpha.4"
   },
   "note": "release.yml publishes the default channel's builds as non-prerelease, so the redirect can be an alpha"
  },
  {
   "name": "redirect is an alpha and the feed window has no stable: stable resolves to nothing, not to the alpha",
   "tags": [
    "v1.6.0-alpha.2",
    "v1.6.0-alpha.1"
   ],
   "stable_tag": "v1.6.0-alpha.2",
   "expect": {
    "stable": null,
    "beta": null,
    "alpha": "v1.6.0-alpha.2"
   },
   "note": "callers page the feed further back (?after=) before concluding there is no stable"
  }
 ]
}
