---
import Base from "../../layouts/Base.astro";
import { readFileSync } from "node:fs";
import { renderChangelog } from "../../../functions/_lib/changelog";
import { changelogBody } from "../../../functions/_lib/page";

// Offline fallback: the same renderer the edge function uses, over the checkout's CHANGELOG.md.
const body = changelogBody(renderChangelog(readFileSync("../CHANGELOG.md", "utf8")), { tag: "", stale: false, fallback: true });
---
<Base ground="paper" title="Changelog · Atlas" description="Every Atlas release: CLI, TUI, MCP server and Atlas Desktop.">
	<div class="wrap page">
		<!-- The edge function (functions/changelog.ts) replaces everything between the CHANGELOG markers with the latest published
		     release's changelog. What is built here is the offline fallback: correct as of the last deploy, never relied on. -->
		<article class="prose" data-changelog><h1 class="display">Changelog</h1><Fragment set:html="<!--CHANGELOG-->" /><Fragment set:html={body} /><Fragment set:html="<!--/CHANGELOG-->" /></article>
	</div>
</Base>
<style>
	.page { max-width: 820px; padding: 7rem 0 4rem; }
	.prose { min-width: 0; overflow-wrap: break-word; }
	.prose h1 { font-family: var(--font); font-weight: 800; font-stretch: 68%; letter-spacing: -0.012em; line-height: 0.92; text-wrap: balance; font-size: clamp(2.6rem, 6vw, 4.6rem); margin: 0 0 1.6rem; }
	.prose :global(h2) { font-weight: 800; font-stretch: 75%; font-size: 2rem; line-height: 1.05; margin: 3.2rem 0 1rem; padding-top: 0.8rem; border-top: 2px solid var(--fg); }
	.prose :global(h3) { font-weight: 800; font-stretch: 80%; font-size: 1.1rem; margin: 2rem 0 0.6rem; }
	.prose :global(p), .prose :global(li) { color: var(--fg-2); font-size: 1rem; line-height: 1.65; }
	.prose :global(li) { margin: 0.45rem 0; }
	.prose :global(strong) { color: var(--fg); }
	.prose :global(code) { background: rgb(12 16 56 / 0.08); color: var(--fg); padding: 0.1em 0.38em; border-radius: 0; font-size: 0.86em; }
	.prose :global(a) { color: var(--fg); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 0.2em; }
	.prose :global(.anchor) { display: none; }
	.prose :global(:not(pre) > code) { overflow-wrap: anywhere; }
	.prose :global(pre) { overflow-x: auto; max-width: 100%; }
	.prose :global(table) { display: block; overflow-x: auto; max-width: 100%; }
	.prose :global(.cl-meta) { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; align-items: baseline; margin: 0 0 1.4rem; color: var(--fg-2); font-size: 0.95rem; }
	.prose :global(.cl-meta a) { font-weight: 600; display: inline-flex; align-items: center; min-height: 44px; }
	.prose :global(.cl-stale) { margin: 0 0 1.2rem; padding: 0.6rem 0.9rem; border: 1.5px solid var(--fg); font-size: 0.92rem; }
	.prose :global(.cl-jump) { display: flex; flex-wrap: wrap; gap: 0.3rem 0.5rem; margin: 0 0 0.5rem; padding: 0; list-style: none; }
	.prose :global(.cl-jump a) { display: inline-block; padding: 0.35rem 0.7rem; box-shadow: inset 0 0 0 1.5px var(--paper-line); text-decoration: none; font-weight: 600; font-size: 0.9rem; border-radius: 999px; }
	.prose :global(.cl-jump a:hover) { box-shadow: inset 0 0 0 1.5px var(--fg); }
	.prose :global(section[id]) { scroll-margin-top: 5rem; }
	@media (max-width: 760px) {
		.page { padding: calc(5.5rem + env(safe-area-inset-top)) 0 3rem; }
		.prose :global(h2) { font-size: 1.75rem; margin-top: 2.6rem; }
		.prose :global(p), .prose :global(li) { font-size: 1.0625rem; line-height: 1.65; }
		.prose :global(a) { padding-block: 0.45em; }
		.prose :global(.cl-jump a) { padding-block: 0.7rem; }
		.prose :global(li) { margin: 0.2rem 0; }
		.prose :global(ul), .prose :global(ol) { padding-left: 1.3rem; }
	}
</style>
