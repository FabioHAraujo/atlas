---
import Base from "../layouts/Base.astro";
import InstallCopy from "../components/islands/InstallCopy.svelte";
import Waitlist from "../components/islands/Waitlist.svelte";
import ShareLink from "../components/islands/ShareLink.svelte";
import { latestRelease, fmtDate, fmtSize } from "../data/release";
import { SITE } from "../data/site";

const rel = await latestRelease();
const dmgUrl = rel.dmg?.url ?? SITE.releases;
const dmgLabel = rel.version ? `Atlas ${rel.version} for Apple silicon` : "Latest release on GitHub";
const desc = "Download Atlas for macOS (Apple silicon). Windows, Linux and Intel Macs are coming soon; the CLI builds from source on Linux today.";

// Platforms that are not shipped yet. `topic` is stored with the email by /api/waitlist.
const soon = [
	{ topic: "macos-intel", name: "macOS, Intel", note: "x86-64 Macs", icon: `<path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z"/><path d="M10 2c1 .5 2 2 2 5"/>` },
	{ topic: "windows", name: "Windows", note: "Windows 11, x64 and Arm", icon: `<rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/>` },
	{ topic: "linux", name: "Linux", note: "x64 and Arm, AppImage and .deb", icon: `<path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>` },
];
const reqs: [string, string][] = [
	["System", "macOS 13 Ventura or later"],
	["Chip", "Apple silicon (M1 or later)"],
	["Optional", "git and gh for worktrees and pull requests; Docker (OrbStack or Docker Desktop) for an infra: block"],
];
---
<Base title="Download Atlas" description={desc} jsonLd={{
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Atlas",
	applicationCategory: "DeveloperApplication",
	operatingSystem: "macOS 13+ (Apple silicon)",
	softwareVersion: rel.version || undefined,
	datePublished: rel.date || undefined,
	downloadUrl: dmgUrl,
	url: `${SITE.url}/download/`,
	offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
	license: ["https://opensource.org/licenses/MIT", "https://opensource.org/licenses/Apache-2.0"],
}}>
	<section class="dl sec" aria-labelledby="dl-h">
		<div class="wrap">
			<header class="head">
				<h1 id="dl-h" class="display">Get Atlas.</h1>
				<p class="lead">The desktop app and the <code>atlas</code> command line, in one download. Free and open source.</p>
			</header>

			<section class="phone" aria-labelledby="phone-h" data-phone hidden>
				<h2 id="phone-h" class="h">On your phone?</h2>
				<p class="sub">Atlas runs on a computer. Send yourself the link and open it there.</p>
				<ShareLink client:visible url={`${SITE.url}/download/`} />
			</section>

			<!-- The page opens on the platform that is available today; the script only changes the copy for other visitors -->
			<div class="grid">
				<article class="primary" aria-labelledby="mac-h" data-card="macos-arm">
					<div class="top">
						<span class="badge"><i class="dot go"></i> Available now</span>
						<span class="you" data-you hidden>Your Mac</span>
					</div>
					<h2 id="mac-h" class="display">macOS</h2>
					<p class="sub" data-label>{dmgLabel}</p>
					<div class="cta">
						<a class="btn solid big" href={dmgUrl} rel="noopener" data-dmg>Download for Mac (.dmg)</a>
						<span class="meta" data-size>{rel.dmg ? `${fmtSize(rel.dmg.size)} · Apple silicon` : "Apple silicon"}</span>
					</div>
					<p class="note" data-intel hidden>This download is for Apple silicon. Intel Macs are coming soon: use Notify me below.</p>
					<div class="cli">
						<p class="cli-h">Or install the command line and the app from a terminal</p>
						<InstallCopy client:load cmd={SITE.install} />
						<p class="fine">Then run <code>atlas desktop</code> to install the app. <a class="ln" href="/docs/installation/">Install guide</a></p>
					</div>
				</article>

				<aside class="side" aria-label="This release">
					<dl class="facts">
						<div><dt>Version</dt><dd>{rel.version ? <a class="ln" href={rel.notes} rel="noopener" data-ver>{rel.version}</a> : <a class="ln" href={rel.notes} rel="noopener" data-ver>Latest</a>}</dd></div>
						<div><dt>Released</dt><dd><time data-date datetime={rel.date || undefined}>{rel.date ? fmtDate(rel.date) : "Latest release"}</time></dd></div>
						<div><dt>Notes</dt><dd><a class="ln" href="/changelog/">Changelog</a>{" "}<a class="ln" href={rel.notes} rel="noopener" data-notes>Release page</a></dd></div>
						<div><dt>License</dt><dd>MIT or Apache-2.0</dd></div>
					</dl>
					<h3>System requirements</h3>
					<dl class="facts req">
						{reqs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
					</dl>
				</aside>
			</div>

			<section class="soon" aria-labelledby="soon-h">
				<h2 id="soon-h" class="h">Coming soon</h2>
				<p class="sub">Atlas is built to run anywhere you write code. Tell us where you want it and we will email you when it ships.</p>
				<ul class="cards">
					{soon.map((p) => (
						<li class="card" data-card={p.topic}>
							<div class="ct">
								<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
								<div>
									<h3>{p.name}</h3>
									<p class="pn">{p.note}</p>
								</div>
								<span class="badge soon-b">Coming soon</span>
							</div>
							<Waitlist client:visible variant="close" topic={p.topic} id={p.topic} cta="Notify me" title="We will tell you." done={`One email when Atlas for ${p.name} ships.`} />
						</li>
					))}
				</ul>
				<p class="fine src"><b>Linux today:</b> the CLI, the TUI and the MCP server build from source and pass their tests in CI. <a class="ln" href="/docs/installation/#build-from-source">Build from source</a> · <a class="ln" href={SITE.github} rel="noopener">GitHub</a></p>
			</section>

			<section class="verify" aria-labelledby="sum-h">
				<h2 id="sum-h" class="h">Verify your download</h2>
				<p class="sub">SHA-256, read from the latest release. Check with <code>shasum -a 256 &lt;file&gt;</code>. Every asset on the <a class="ln" href={SITE.releases} rel="noopener" data-notes>release page</a> also has a <code>.sha256</code> file next to it.</p>
				<dl class="sums" data-sums hidden={!(rel.dmg && rel.cli)}>
					<div><dt data-n="dmg">{rel.dmg?.name}</dt><dd><code data-s="dmg">{rel.dmg?.sha256}</code></dd></div>
					<div><dt data-n="cli">{rel.cli?.name}</dt><dd><code data-s="cli">{rel.cli?.sha256}</code></dd></div>
				</dl>
			</section>
		</div>
	</section>
</Base>

<script>
	// Detects the visitor's OS and chip and adjusts the page: the matching card gets a label, Intel Macs get an honest note,
	// phones get the send-me-the-link block. Works without it: the static page already leads with the only shipped build.
	type UAData = { platform?: string; mobile?: boolean; getHighEntropyValues?: (h: string[]) => Promise<{ architecture?: string; bitness?: string }> };
	const nav = navigator as Navigator & { userAgentData?: UAData };
	const ua = navigator.userAgent;
	const uad = nav.userAgentData;
	const mobile = uad?.mobile ?? /Android|iPhone|iPad|iPod|Mobile/i.test(ua);
	const plat = (uad?.platform ?? navigator.platform ?? "").toLowerCase();
	const os = mobile ? "mobile" : /mac/.test(plat) || /Macintosh/.test(ua) ? "mac" : /win/.test(plat) ? "windows" : /linux|cros|x11/.test(plat) || /Linux/.test(ua) ? "linux" : "other";
	const root = document.documentElement;
	root.dataset.os = os;

	const show = (sel: string, on = true) => document.querySelectorAll<HTMLElement>(sel).forEach((el) => (el.hidden = !on));
	if (os === "mobile") show("[data-phone]");
	if (os === "mac") show("[data-you]");
	if (os === "windows" || os === "linux") document.querySelector(`[data-card="${os}"]`)?.setAttribute("data-you", "");

	// Apple silicon vs Intel: only Chromium exposes the architecture; Safari hides it, so for Safari we say nothing rather than guess.
	if (os === "mac" && uad?.getHighEntropyValues) {
		uad.getHighEntropyValues(["architecture"]).then((v) => {
			if (v.architecture === "x86") {
				show("[data-you]", false);
				show("[data-intel]");
				document.querySelector('[data-card="macos-intel"]')?.setAttribute("data-you", "");
			}
		}).catch(() => {});
	}

	// Live release: the page is built once, but the numbers on it come from the edge (/release.json, resolved from the latest GitHub
	// release and cached for about a minute), so a release shows here without a site deploy. The built values are only the first paint.
	interface Asset { name: string; url: string; sha256: string; size: number }
	interface Rel { tag: string; version: string; date: string; notes: string; dmg?: Asset; cli?: Asset }
	const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s);
	const apply = (r: Rel) => {
		if (!r.version) return;
		const btn = $<HTMLAnchorElement>("[data-dmg]");
		if (btn && r.dmg) btn.href = r.dmg.url;
		const label = $("[data-label]");
		if (label) label.textContent = `Atlas ${r.version} for Apple silicon`;
		const size = $("[data-size]");
		if (size && r.dmg) size.textContent = `${(r.dmg.size / 1_048_576).toFixed(1)} MB · Apple silicon`;
		const ver = $<HTMLAnchorElement>("[data-ver]");
		if (ver) { ver.textContent = r.version; ver.href = r.notes; }
		document.querySelectorAll<HTMLAnchorElement>("[data-notes]").forEach((a) => (a.href = r.notes));
		const t = $<HTMLTimeElement>("[data-date]");
		if (t && r.date) { t.dateTime = r.date; t.textContent = new Date(`${r.date}T00:00:00Z`).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }); }
		if (r.dmg && r.cli) {
			for (const [k, a] of [["dmg", r.dmg], ["cli", r.cli]] as const) {
				const n = $(`[data-n="${k}"]`), s = $(`[data-s="${k}"]`);
				if (n) n.textContent = a.name;
				if (s) s.textContent = a.sha256;
			}
			const sums = $("[data-sums]");
			if (sums) sums.hidden = false;
		}
		document.documentElement.dataset.release = r.version;
	};
	fetch("/release.json", { headers: { accept: "application/json" } })
		.then((r) => (r.ok ? (r.json() as Promise<Rel>) : Promise.reject()))
		.then(apply)
		.catch(() => {
			// /release.json is same-origin and serves its last good copy when GitHub is down; if even that fails, the built values stay.
		});
</script>

<style>
	.dl { padding: clamp(5rem, 10vw, 7rem) 0 var(--s-7); }
	.head { display: grid; gap: var(--s-2); margin-bottom: var(--s-5); }
	h1 { font-size: clamp(3rem, 8vw, 5.5rem); }
	.lead { max-width: 40ch; color: var(--white); }
	.h { font: 800 clamp(1.5rem, 3.2vw, 2.1rem)/1.05 var(--font); font-stretch: 72%; letter-spacing: -0.005em; margin: 0; }
	.sub { margin: 0; color: var(--fg-2); max-width: 56ch; }
	.fine { margin: 0.9rem 0 0; color: var(--fg-2); font-size: 0.95rem; }
	.badge { display: inline-flex; align-items: center; gap: 0.5rem; font: 700 0.82rem/1 var(--font); padding: 0.4rem 0.7rem; border-radius: 999px; box-shadow: inset 0 0 0 1.5px var(--blue-line); white-space: nowrap; }
	.soon-b { color: var(--wait); box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--wait) 55%, transparent); }

	.grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(16rem, 1fr); gap: var(--s-5); align-items: start; }
	.primary { display: grid; gap: var(--s-3); padding: clamp(1.25rem, 3vw, 2.25rem); background: var(--blue-deep); border-radius: 12px; box-shadow: 0 0 0 1px var(--blue-line), 0 30px 60px -30px rgb(2 4 50 / 0.8); min-width: 0; }
	.primary .top { display: flex; justify-content: space-between; align-items: center; gap: var(--s-2); }
	.primary h2 { font-size: clamp(2.6rem, 6vw, 4.2rem); }
	.you { font: 700 0.82rem/1 var(--font); color: var(--ink); background: var(--go); padding: 0.4rem 0.65rem; border-radius: 999px; }
	.cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-4); margin-top: var(--s-2); }
	.big { padding: 1.05rem 1.6rem; font-size: 1.1rem; }
	.meta { color: var(--fg-2); font-size: 0.92rem; }
	.note { margin: 0; color: var(--wait); font-weight: 600; }
	.cli { margin-top: var(--s-3); padding-top: var(--s-4); border-top: 1px solid var(--blue-line); min-width: 0; }
	.cli-h { margin: 0 0 var(--s-2); font-weight: 700; }

	.side { display: grid; gap: var(--s-4); min-width: 0; }
	.side h3 { margin: var(--s-2) 0 0; font: 800 1.1rem/1 var(--font); font-stretch: 80%; }
	.facts { margin: 0; display: grid; }
	.facts > div { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: var(--s-3); padding: 0.7rem 0; border-top: 1px solid var(--blue-line); }
	.facts > div:last-child { border-bottom: 1px solid var(--blue-line); }
	.facts dt { color: var(--fg-2); }
	.facts dd { margin: 0; font-weight: 600; display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; }

	.soon, .verify { margin-top: var(--s-7); display: grid; gap: var(--s-3); }
	.phone { margin-bottom: var(--s-5); padding: var(--s-4); display: grid; gap: var(--s-3); border-radius: 12px; background: var(--white); color: var(--ink); --fg: var(--ink); --fg-2: var(--ink-2); --bg: var(--white); }
	.phone .h { color: var(--ink); }
	.phone[hidden] { display: none; }
	.cards { list-style: none; margin: var(--s-3) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: var(--s-4); }
	.card { display: grid; align-content: space-between; gap: var(--s-4); padding: var(--s-4); border-radius: 10px; box-shadow: inset 0 0 0 1px var(--blue-line); min-width: 0; }
	.card[data-you] { box-shadow: inset 0 0 0 2px var(--wait); }
	.ct { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.3rem var(--s-3); align-items: start; }
	.ct svg { margin-top: 0.15rem; }
	.ct .badge { grid-column: 1 / -1; justify-self: start; }
	.ct h3 { margin: 0; font: 800 1.35rem/1.1 var(--font); font-stretch: 80%; }
	.pn { margin: 0.2rem 0 0; color: var(--fg-2); font-size: 0.92rem; }
	.src { max-width: 70ch; }

	.sums { margin: 0; display: grid; gap: var(--s-3); }
	.sums > div { display: grid; gap: 0.3rem; min-width: 0; }
	.sums dt { font-weight: 700; overflow-wrap: anywhere; }
	.sums dd { margin: 0; min-width: 0; }
	.sums code { display: block; padding: 0.7rem 0.9rem; background: rgb(255 255 255 / 0.08); font-size: 0.82rem; overflow-wrap: anywhere; word-break: break-all; }

	/* Phones: the .dmg is for a computer, so the button steps back; the send-me-the-link block above leads */
	:global(html[data-os="mobile"]) .big { background: transparent; color: var(--fg); border-color: var(--fg); }
	@media (max-width: 860px) { .grid { grid-template-columns: minmax(0, 1fr); } .side { grid-row: 2; } }
	@media (max-width: 520px) { .cta .btn { width: 100%; } .facts > div { grid-template-columns: 5.5rem minmax(0, 1fr); } }
</style>
